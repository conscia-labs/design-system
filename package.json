{
  "name": "@conscia-code/design-system",
  "version": "0.1.0",
  "description": "The shared React component library for building clear, consistent, and accessible Conscia product experiences.",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./src/foundation/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/foundation/styles.css"
  },
  "scripts": {
    "dev:playground": "next dev playground --webpack -p 3020",
    "build:playground": "next build playground",
    "start:playground": "next start playground -p 3020",
    "test": "node --test playground/src/test/*.test.mjs",
    "lint": "eslint src --max-warnings=0",
    "lint:playground": "eslint playground --max-warnings=0 --config playground/eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:playground": "tsc --noEmit -p playground/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conscia-code/design-system.git"
  },
  "homepage": "https://github.com/conscia-code/design-system#readme",
  "bugs": {
    "url": "https://github.com/conscia-code/design-system/issues"
  },
  "keywords": [
    "conscia",
    "design-system",
    "react",
    "radix-ui",
    "tailwindcss",
    "components"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
